# ── Serveur ────────────────────────────────────────────────────────────
PORT=4000
DATABASE_URL=postgres://greliv:greliv@localhost:5432/greliv
# À CHANGER en production : chaîne aléatoire d'au moins 32 caractères
JWT_SECRET=dev-secret-a-changer-absolument
# Origine(s) autorisée(s) pour le front (séparées par des virgules). * en dev.
CORS_ORIGIN=*
# URL publique du front (liens de retour Stripe Connect)
PUBLIC_URL=http://localhost:5173

# ── Paiement (Stripe, mode test) ───────────────────────────────────────
# Laisser vide = prestataire « simulé » (aucun débit réel, carte test 4242…)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cartographie / itinéraires ─────────────────────────────────────────
# osrm (défaut, sans clé) | mapbox (trafic temps réel, clé requise) | none
ROUTING_PROVIDER=osrm
OSRM_URL_CAR=https://routing.openstreetmap.de/routed-car
OSRM_URL_BIKE=https://routing.openstreetmap.de/routed-bike
MAPBOX_TOKEN=
# ban = Base Adresse Nationale (gratuite, sans clé) | none = liste locale
GEOCODER=ban

# ── Notifications push (Firebase Cloud Messaging) ──────────────────────
# Chemin vers le JSON du compte de service Firebase. Vide = push désactivé
# (les notifications in-app et WebSocket fonctionnent toujours).
FCM_SERVICE_ACCOUNT=

# ── Fichiers ───────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
